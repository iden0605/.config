layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
    }
    tab name="claude" focus=true {
        pane split_direction="vertical" {
            pane command="sh" {
                args "-c" "claude; exec $SHELL"
            }
            pane {}
        }
    }
    tab name="editor" {
        pane {
            command "nvim"
            args "."
        }
    }
    tab name="music" {
        pane {
            command "ncspot"
        }
    }
}
